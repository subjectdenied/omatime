{
  "schemaVersion": 1,
  "id": "chris.timetracker",
  "name": "Time Tracker",
  "version": "1.0.0",
  "author": "Chris",
  "license": "MIT",
  "description": "Zeiterfassung im Omarchy-Bar: liest und schreibt das CSV der GNOME-Time-Tracker-App und schlägt für neue Einträge die WLAN-Anmeldezeiten im Büro-Netz vor.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Time Tracker",
    "description": "Timer starten/stoppen, Einträge aus tafel_office-WLAN-Zeiten anlegen; Datenbasis ist ~/.local/share/time-tracker/log.csv (kompatibel zur GTK-App).",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "csvPath": "",
      "ssid": "",
      "defaultProject": "tafel österreich",
      "roundMinutes": 15,
      "weeklyHours": 35,
      "workDays": 5,
      "vacationDays": 25,
      "vacationProject": "urlaub",
      "homeofficeDays": "",
      "homeofficeTopic": "homeoffice",
      "baseDate": "",
      "baseVacationLeft": -1,
      "baseSurplusHours": "",
      "breakAfterHours": 6,
      "breakMinutes": 30
    },
    "schema": [
      {
        "key": "csvPath",
        "type": "path",
        "label": "Log-CSV",
        "defaultValue": "",
        "description": "Pfad zur Time-Tracker-CSV. Leer = ~/.local/share/time-tracker/log.csv"
      },
      {
        "key": "ssid",
        "type": "string",
        "label": "Büro-WLAN (SSID)",
        "defaultValue": "",
        "description": "Anmeldezeiten in dieses WLAN werden als Start/Ende vorgeschlagen. Leer = aktuell verbundenes WLAN automatisch verwenden."
      },
      {
        "key": "defaultProject",
        "type": "string",
        "label": "Standard-Projekt",
        "defaultValue": "tafel österreich"
      },
      {
        "key": "roundMinutes",
        "type": "integer",
        "label": "Vorschläge runden (Minuten)",
        "min": 0,
        "max": 30,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "weeklyHours",
        "type": "integer",
        "label": "Wochenstunden (Soll)",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 35
      },
      {
        "key": "workDays",
        "type": "integer",
        "label": "Arbeitstage pro Woche",
        "min": 1,
        "max": 7,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "vacationDays",
        "type": "integer",
        "label": "Urlaubstage pro Jahr",
        "min": 0,
        "max": 60,
        "step": 1,
        "defaultValue": 25
      },
      {
        "key": "vacationProject",
        "type": "string",
        "label": "Urlaubs-Projekt",
        "defaultValue": "urlaub",
        "description": "Einträge dieses Projekts zählen nicht als Arbeitszeit und verbrauchen je Tag einen Urlaubstag."
      },
      {
        "key": "homeofficeDays",
        "type": "string",
        "label": "Homeoffice-Wochentage",
        "defaultValue": "",
        "description": "Kommagetrennt, z.B. \"Fr\" oder \"Mi,Fr\" (Mo/Di/Mi/Do/Fr/Sa/So). Einträge an diesen Tagen bekommen automatisch die Beschreibung des Homeoffice-Themas."
      },
      {
        "key": "homeofficeTopic",
        "type": "string",
        "label": "Homeoffice-Thema (Beschreibung)",
        "defaultValue": "homeoffice"
      },
      {
        "key": "baseDate",
        "type": "string",
        "label": "Stichtag (YYYY-MM-DD)",
        "defaultValue": "",
        "description": "Ab diesem Tag (inklusive) rechnen Überstundenkonto und Rest-Urlaub von den Startwerten weiter — für Tracking-Start mitten im Jahr."
      },
      {
        "key": "baseVacationLeft",
        "type": "integer",
        "label": "Rest-Urlaub am Stichtag",
        "min": -1,
        "max": 60,
        "step": 1,
        "defaultValue": -1,
        "description": "-1 = aus (dann vacationDays minus alle Urlaubstage des Jahres)."
      },
      {
        "key": "baseSurplusHours",
        "type": "string",
        "label": "Überstunden am Stichtag",
        "defaultValue": "",
        "description": "\"11:46\" (h:mm) oder \"11.5\" (Dezimalstunden), auch negativ; leer = aus."
      },
      {
        "key": "breakAfterHours",
        "type": "integer",
        "label": "Pause abziehen ab (Stunden/Tag)",
        "min": 0,
        "max": 12,
        "step": 1,
        "defaultValue": 6,
        "description": "Liegt die Brutto-Arbeitszeit eines Tages über diesem Wert, wird die Pause automatisch abgezogen. 0 = aus."
      },
      {
        "key": "breakMinutes",
        "type": "integer",
        "label": "Pausenlänge (Minuten)",
        "min": 0,
        "max": 120,
        "step": 5,
        "defaultValue": 30
      }
    ]
  }
}
